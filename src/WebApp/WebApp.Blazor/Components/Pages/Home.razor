@page "/"
@rendermode InteractiveServer
@using WebApp.Blazor.Models
@using WebApp.Blazor.Rendering
@using WebApp.Blazor.Services
@inject GatewayApiClient GatewayApi
@inject ILogger<Home> Logger

<PageTitle>Smart Product Advisor</PageTitle>

<StartupGate>
<h1>Smart Product Advisor</h1>

<p>
    Describe what you're looking for — e.g. "I need a smartphone with a good camera and a
    budget of up to 15,000 UAH" — and get a grounded, explained recommendation.
</p>

<div class="chat-history">
    @foreach (var entry in _history)
    {
        <div class="chat-message chat-message-@entry.Role">
            <strong>@(entry.Role == "user" ? "You" : "Advisor")</strong>
            @if (entry.Role == "user")
            {
                <p>@entry.Text</p>
            }
            else
            {
                @* Narration only — the LLM's own text, safe to render as Markdown (FR-016). *@
                <div>@((MarkupString)NarrationMarkdownRenderer.ToSafeHtml(entry.Text))</div>
            }
        </div>

        @* Each turn's own structured rendering stays attached to that turn (FR-023) instead of
           sharing one "current result" slot, so an earlier comparison table/recommendation list
           doesn't disappear from view once a later turn's result arrives. *@
        @if (entry.Turn is { Type: "clarification" } clarificationTurn)
        {
            <div class="alert alert-info">@((MarkupString)NarrationMarkdownRenderer.ToSafeHtml(clarificationTurn.Question ?? ""))</div>
        }
        @* Store-policy sources (002 FR-008). Rendered as plain markup, never through the
           narration's Markdown path: a citation is structured provenance the shopper must be able
           to trust, so it is never assembled from LLM-authored text. *@
        else if (entry.Turn is { Type: "answer", Citations: { Count: > 0 } citations })
        {
            <div class="citation-list">
                <small>
                    <strong>Source@(citations.Count > 1 ? "s" : ""):</strong>
                    @string.Join(", ", citations.Select(c => c.DocumentTitle))
                </small>
            </div>
        }
        else if (entry.Turn is { Type: "recommendation" } recommendationTurn)
        {
            @if (recommendationTurn.Items is { Count: > 0 })
            {
                <div class="recommendation-list">
                    @foreach (var item in recommendationTurn.Items)
                    {
                        <div class="recommendation-card">
                            <h3><a href="@($"products/{item.ProductId}")">@item.Name</a></h3>
                            <p>
                                @if (item.Price is not null)
                                {
                                    <span>@item.Price.Amount @item.Price.Currency</span>
                                    @if (!item.PriceVerified)
                                    {
                                        <em> (price could not be verified)</em>
                                    }
                                }
                                else
                                {
                                    <em>Price could not be verified</em>
                                }
                                —
                                @if (item.AvailabilityVerified)
                                {
                                    <span>@item.Availability</span>
                                }
                                else
                                {
                                    <em>Availability could not be verified</em>
                                }
                            </p>
                            <p><strong>Why it matches:</strong></p>
                            <ul>
                                @foreach (var reason in item.MatchedRequirements)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                            <p><strong>Trade-offs:</strong></p>
                            <ul>
                                @foreach (var tradeOff in item.TradeOffs)
                                {
                                    <li>@tradeOff</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">@recommendationTurn.UnmetConstraintExplanation</div>
            }
        }
        else if (entry.Turn is { Type: "comparison", Criteria: not null, Rows: not null } comparisonTurn)
        {
            <div class="comparison-table-wrapper">
                <table class="comparison-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            @foreach (var criterion in comparisonTurn.Criteria)
                            {
                                <th>@criterion</th>
                            }
                            <th>Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in comparisonTurn.Rows)
                        {
                            <tr>
                                <td><a href="@($"products/{row.ProductId}")">@row.Name</a></td>
                                @foreach (var criterion in comparisonTurn.Criteria)
                                {
                                    <td>
                                        @(row.Values.GetValueOrDefault(criterion) ?? "Not verified")
                                        @{ var delta = row.DeltasVsBest.GetValueOrDefault(criterion); }
                                        @if (!string.IsNullOrEmpty(delta))
                                        {
                                            <br />
                                            <small>@delta</small>
                                        }
                                    </td>
                                }
                                <td>@row.Rating</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (entry.Turn is { Type: "checkoutLink", Url: not null } checkoutLinkTurn)
        {
            <div class="checkout-link-card">
                <a href="@checkoutLinkTurn.Url" target="_blank" rel="noopener noreferrer" class="checkout-link-button">
                    Proceed to checkout (@checkoutLinkTurn.ProductIds?.Count product(s))
                </a>
            </div>
        }
    }
    @if (_isStreamingAssistantTurn)
    {
        <div class="chat-message chat-message-assistant">
            <strong>Advisor</strong>
            <div>@((MarkupString)NarrationMarkdownRenderer.ToSafeHtml(_streamingNarration))</div>
        </div>
    }
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<div class="chat-input">
    <input @bind="_draftMessage" @bind:event="oninput" @onkeydown="OnKeyDownAsync"
           placeholder="Describe what you're looking for..." disabled="@_isSending" />
    <button @onclick="SendAsync" disabled="@(_isSending || string.IsNullOrWhiteSpace(_draftMessage))">
        Send
    </button>
</div>
</StartupGate>

@code {
    private sealed record HistoryEntry(string Role, string Text, ChatTurnDto? Turn);

    private readonly List<HistoryEntry> _history = [];
    private string _draftMessage = "";
    private bool _isSending;
    private bool _isStreamingAssistantTurn;
    private string _streamingNarration = "";
    private Guid? _sessionId;
    private string? _errorMessage;

    private async Task OnKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftMessage) || _isSending)
        {
            return;
        }

        var message = _draftMessage;
        _draftMessage = "";
        _isSending = true;
        _errorMessage = null;
        _history.Add(new HistoryEntry("user", message, null));

        try
        {
            var turn = await TryStreamingAsync(message) ?? await GatewayApi.SendMessageAsync(_sessionId, message, CancellationToken.None);
            ApplyTurnResult(turn);
        }
        catch (Exception ex) when (ex is MissingSignInTokenException
            || (ex is HttpRequestException httpEx && httpEx.StatusCode == System.Net.HttpStatusCode.Unauthorized))
        {
            // TryStreamingAsync (below) swallows its own exception and returns null on any
            // failure, including this one — so this clause is what actually catches it, from the
            // non-streaming fallback call that always runs afterward.
            Logger.LogWarning(ex, "Gateway rejected the chat request because the sign-in token is missing, invalid, or expired.");
            _errorMessage = "Your sign-in session has expired. Please sign out and sign in again.";
        }
        catch (Exception ex)
        {
            // Honest partial response at the UI layer too (constitution Principle V): a
            // downstream outage must not crash the chat, it must say so.
            _errorMessage = "Sorry, the advisor isn't reachable right now. Please try again shortly.";
            Logger.LogError(ex, "Chat request failed after both streaming and non-streaming attempts.");
        }
        finally
        {
            _isStreamingAssistantTurn = false;
            _streamingNarration = "";
            _isSending = false;
        }
    }

    /// <summary>
    /// Streams the turn's narration progressively (FR-015). Returns null — signalling the caller
    /// to fall back to the non-streaming endpoint — if the connection ends without ever producing
    /// a result (contracts/gateway-bff-api.md: "connection closed without a result event" MUST be
    /// treated as a failure, never a silently-accepted empty answer).
    /// </summary>
    private async Task<ChatTurnDto?> TryStreamingAsync(string message)
    {
        try
        {
            _isStreamingAssistantTurn = true;
            _streamingNarration = "";
            ChatTurnDto? result = null;

            await foreach (var update in GatewayApi.StreamMessageAsync(_sessionId, message, CancellationToken.None))
            {
                if (update.Delta is not null)
                {
                    _streamingNarration += update.Delta;
                    StateHasChanged();
                }
                else if (update.Result is not null)
                {
                    result = update.Result;
                }
            }

            return result;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Streaming chat failed; falling back to the non-streaming endpoint.");
            return null;
        }
    }

    private void ApplyTurnResult(ChatTurnDto turn)
    {
        _sessionId = turn.SessionId;

        var narration = turn.Type switch
        {
            // Deliberately NOT turn.Question here — the "clarification" alert box below already
            // renders it (line ~40); including it here too duplicated the same question text in
            // both the plain chat bubble and the alert box.
            "clarification" => "",
            // Every other type carries its text in Message. Defaulting to Message rather than ""
            // matters: an allow-list here silently blanked `answer`, `unsupported` and `error`,
            // so a store-policy reply (and any smalltalk reply) flashed on screen during
            // streaming and then vanished when the completed turn replaced it with nothing.
            _ => turn.Message ?? "",
        };
        _history.Add(new HistoryEntry("assistant", narration, turn));
    }
}
