@* Starting-up screen (US6, FR-033–FR-035, research.md §19): checks whether every internal
   service the advisor depends on is reachable before showing the interactive chat UI, rather
   than presenting an experience that looks ready but silently fails on the first real request.
   The wait is bounded — after MaxStartupWait, the UI proceeds anyway with an honest, non-blocking
   indication of which service(s) are still unreachable (constitution Principle V). *@
@rendermode InteractiveServer
@using WebApp.Blazor.Models
@using WebApp.Blazor.Services
@inject GatewayApiClient GatewayApi
@inject ILogger<StartupGate> Logger

@if (_showGate)
{
    <div class="startup-gate">
        <h2>Starting up…</h2>
        <ul>
            @foreach (var service in _services)
            {
                <li>@service.Name: @(service.Reachable ? "ready" : "checking…")</li>
            }
        </ul>
    </div>
}
else
{
    @if (_gatewayUnreachable)
    {
        <div class="alert alert-danger">
            Can't reach the advisor right now. Continuing — some features may be temporarily unavailable.
        </div>
    }
    else if (_degraded)
    {
        <div class="alert alert-warning">
            Still starting up: @string.Join(", ", _services.Where(s => !s.Reachable).Select(s => s.Name)).
            Continuing — some features may be temporarily unavailable.
        </div>
    }
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static readonly TimeSpan MaxStartupWait = TimeSpan.FromMinutes(4);
    private static readonly TimeSpan StatusRequestTimeout = TimeSpan.FromMinutes(3);
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    private bool _showGate = true;
    private bool _degraded;
    private bool _gatewayUnreachable;
    private IReadOnlyList<ServiceReadinessDto> _services = [];

    protected override async Task OnInitializedAsync()
    {
        var deadline = DateTimeOffset.UtcNow + MaxStartupWait;
        var attempt = 0;

        while (DateTimeOffset.UtcNow < deadline)
        {
            attempt++;
            var remaining = deadline - DateTimeOffset.UtcNow;
            using var requestCts = new CancellationTokenSource(
                remaining < StatusRequestTimeout ? remaining : StatusRequestTimeout);

            try
            {
                var status = await GatewayApi.GetSystemStatusAsync(requestCts.Token);
                _services = status.Services;
                _gatewayUnreachable = false;
                if (status.Overall == "ready")
                {
                    _showGate = false;
                    return;
                }
            }
            catch (Exception ex)
            {
                // Gateway itself unreachable — keep retrying within the bounded wait (edge case:
                // spec.md "web application itself cannot reach the Gateway").
                _gatewayUnreachable = true;
                Logger.LogWarning(ex, "Startup readiness attempt {Attempt} failed.", attempt);
            }

            StateHasChanged();
            remaining = deadline - DateTimeOffset.UtcNow;
            if (remaining > TimeSpan.Zero)
            {
                await Task.Delay(remaining < PollInterval ? remaining : PollInterval);
            }
        }

        // Bounded wait elapsed — proceed anyway, honestly labeled, rather than blocking
        // indefinitely (FR-034/SC-021).
        _degraded = true;
        _showGate = false;
    }
}
